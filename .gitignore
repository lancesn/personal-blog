node_modules/

# Generated by `npm run build` (scripts/build.js) — the actual deploy
# (.github/workflows/pages.yml) builds fresh from content/posts/*.md and
# uploads dist/ straight to GitHub Pages as an artifact; it never reads
# these root-level mirror copies. Keeping them committed only let them
# silently fall out of sync with content/posts (they had, badly).
/dist/
/posts/
/tags/
/blog/
/index.html
/blog.html
/about.html
/archive.html
/search.html
/tags.html
/404.html
/random.html
/rss.xml
/sitemap.xml
/robots.txt
/.nojekyll
